# ひな型です。実際の値は .env.local に書き、リポジトリには入れないでください。

# 空なら、組み込みの PostgreSQL（PGlite）を .data/ に保存して使います。
# コンテナの PostgreSQL を使う場合は、docker compose up -d のあと次を有効にします。
# DATABASE_URL=postgres://mealplanner:mealplanner@localhost:5432/mealplanner

# Cookie に Secure を付けるか。本番は true（既定）。http のローカル確認では false にします。
# 未指定のときは、NODE_ENV が production なら true、それ以外は false。
# COOKIE_SECURE=false

# 状態を変える操作の Origin 照合に使う、このアプリの URL（未指定ならリクエストの URL から判断）。
# APP_ORIGIN=http://localhost:3000

# パスワード変換（bcrypt）のコスト。既定 10（1 秒以内に収まる値）。
# BCRYPT_COST=10

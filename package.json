{
  "name": "meal-planner",
  "version": "0.1.0",
  "private": true,
  "description": "家族で使う献立の候補アプリ（U1 最小の通し版）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run src/db/__tests__ src/repo/__tests__ src/domain/__tests__ src/api/__tests__ src/ui/__tests__",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true});console.log('.data を削除しました')\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "bcryptjs": "3.0.3",
    "next": "15.5.27",
    "pg": "8.16.3",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
